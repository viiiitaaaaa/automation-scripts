{% comment %}
  Липкая кнопка покупки на мобильном.

  Показывается только на узких экранах и только после того, как основная
  кнопка «Add to cart» ушла за верхний край. Отправляет ту же форму товара,
  поэтому ведёт себя ровно как обычная кнопка.

  Принимает:
  - product: {Object} товар
  - product_form_id: {String} id формы товара

  Использование:
  {% render 'sticky-atc', product: product, product_form_id: product_form_id %}
{% endcomment %}
{%- if product != blank and product.available -%}
  <div class="atc-sticky" data-atc-sticky hidden>
    <div class="atc-sticky__inner">
      <span class="atc-sticky__title">{{ product.title | truncate: 40 | escape }}</span>
      <button
        type="submit"
        form="{{ product_form_id }}"
        class="atc-sticky__button button button--primary"
      >
        {{ 'products.product.add_to_cart' | t }}
      </button>
    </div>
  </div>

  {% style %}
    .atc-sticky {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 4;
      padding: 0.8rem 1.2rem calc(0.8rem + env(safe-area-inset-bottom));
      background: rgb(var(--color-background));
      border-top: 0.1rem solid rgba(var(--color-foreground), 0.12);
      transform: translateY(100%);
      transition: transform 0.2s ease;
    }

    .atc-sticky[hidden] {
      display: none;
    }

    .atc-sticky.is-visible {
      transform: translateY(0);
    }

    .atc-sticky__inner {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      max-width: 60rem;
      margin: 0 auto;
    }

    .atc-sticky__title {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 1.3rem;
      line-height: 1.3;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      opacity: 0.85;
    }

    .atc-sticky__button {
      flex: 0 0 auto;
      min-width: 14rem;
      margin: 0;
    }

    @media screen and (min-width: 750px) {
      .atc-sticky {
        display: none;
      }
    }
  {% endstyle %}

  <script>
    (() => {
      const bar = document.querySelector('[data-atc-sticky]');
      const anchor = document.querySelector('.product-form__submit');
      if (!bar || !anchor || !('IntersectionObserver' in window)) return;

      const narrow = window.matchMedia('(max-width: 749px)');
      let anchorVisible = true;

      const paint = () => {
        const show = narrow.matches && !anchorVisible;
        bar.hidden = !show;
        // hidden снимается раньше, чем едет transform, иначе анимации не будет
        requestAnimationFrame(() => bar.classList.toggle('is-visible', show));
      };

      new IntersectionObserver(
        ([entry]) => {
          anchorVisible = entry.isIntersecting;
          paint();
        },
        { rootMargin: '0px 0px -20% 0px' }
      ).observe(anchor);

      narrow.addEventListener('change', paint);
      paint();
    })();
  </script>
{%- endif -%}
