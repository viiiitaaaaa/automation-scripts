<mxfile host="app.diagrams.net">
  <diagram name="AliExpress -> Shopify">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s1" value="1. Скрин магазина AliExpress&#10;(десктопная версия, только .com)&#10;скилл: dolphin-shots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="2. Нарезка карточек товаров&#10;(без названий/цен/рейтингов)&#10;скилл: cut-products" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="3. Разбивка по коллекциям стилей&#10;(2025-26, каждый товар в одну)&#10;скилл: style-collections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s4opt" value="3.1 (опционально) Вырезка без фона&#10;/ пересъёмка в едином стиле&#10;скрипты: cutout_collection.py, product-scenes" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="620" y="260" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="4. Поиск ссылок AliExpress по фото&#10;(сравнение по phash)&#10;скилл: product-links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="5. Импорт ссылок в DSers&#10;(Import list)&#10;скилл: dsers-import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="6. Публикация в Shopify&#10;название, описание, теги, фото, категория, наличие&#10;скилл: shopify-admin (Admin API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="7. Карточка готова в каталоге&#10;витрина ARTMELLIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="320" y="710" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3opt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="s3" target="s4opt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="s4opt" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="s3" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note1" value="Сейчас: каждый шаг запускается вручную командой Claude Code.&#10;Следующий уровень: перенести в n8n как один workflow с кнопкой запуска." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="820" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
